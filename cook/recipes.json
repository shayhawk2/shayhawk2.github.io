    {
      "id": "nonnas-enhanced-meatballs",
      "title": "Nonna's Enhanced Meatballs",
      "emoji": "🍝",
      "category": "sunday",
      "tags": ["italian", "beef", "pork", "freezer-friendly"],
      "prep": 20,
      "cook": 25,
      "servings": 6,
      "equipment": ["Sheet pan", "Dutch oven"],
      "kid": true,
      "placeholder": true,
      "nutrition": { "cal": 480, "protein": 32, "carbs": 22, "fat": 28 },
      "notes": "Stand-in version so the app has something to cook. Send me the real one and I'll swap it in.",
      "ingredients": [
        { "qty": 1, "unit": "cup", "item": "fresh breadcrumbs", "aisle": "Bakery" },
        { "qty": 0.333, "unit": "cup", "item": "whole milk", "aisle": "Dairy & Eggs" },
        { "qty": 2, "unit": "", "item": "large eggs", "aisle": "Dairy & Eggs" },
        { "qty": 0.5, "unit": "cup", "item": "grated Parmesan", "aisle": "Dairy & Eggs" },
        { "qty": 3, "unit": "clove", "item": "garlic", "note": "minced", "aisle": "Produce" },
        { "qty": 0.25, "unit": "cup", "item": "flat-leaf parsley", "note": "chopped", "aisle": "Produce" },
        { "qty": 1, "unit": "tsp", "item": "kosher salt", "aisle": "Spices" },
        { "qty": 0.5, "unit": "tsp", "item": "black pepper", "aisle": "Spices" },
        { "qty": 1, "unit": "lb", "item": "ground beef", "note": "80/20", "aisle": "Meat & Seafood" },
        { "qty": 0.5, "unit": "lb", "item": "ground pork", "aisle": "Meat & Seafood" },
        { "qty": 2, "unit": "tbsp", "item": "olive oil", "aisle": "Pantry" },
        { "qty": 24, "unit": "oz", "item": "marinara sauce", "aisle": "Pantry" }
      ],
      "steps": [
        { "text": "Heat the oven to 425°F and line a sheet pan with parchment.", "uses": [] },
        { "text": "Stir the breadcrumbs into the milk in a large bowl and let them soak for 5 minutes.", "uses": [0, 1] },
        { "text": "Add the eggs, Parmesan, garlic, parsley, salt and pepper. Mix with a fork until even.", "uses": [2, 3, 4, 5, 6, 7] },
        { "text": "Add the beef and pork. Mix gently with your hands just until combined; overmixing makes them tough.", "uses": [8, 9] },
        { "text": "Roll into golf-ball-size meatballs, about 24. Set them on the sheet pan and brush with the olive oil.", "uses": [10] },
        { "text": "Bake for 15 minutes, until browned on top.", "uses": [] },
        { "text": "Warm the marinara in a Dutch oven, add the meatballs and simmer for 10 minutes.", "uses": [11] }
      ]
    },
    {

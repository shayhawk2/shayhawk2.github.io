      "notes": "Stand-in version so the app has something to cook. Send me the real one and I'll swap it in.",
      "ingredients": [
        { "qty": 1.5, "unit": "lb", "item": "boneless, skinless chicken breasts", "note": "about 2 large", "aisle": "Meat & Seafood" },
        { "qty": 1, "unit": "tsp", "item": "kosher salt", "aisle": "Spices" },
        { "qty": 0.5, "unit": "tsp", "item": "black pepper", "aisle": "Spices" },
        { "qty": 0.5, "unit": "cup", "item": "all-purpose flour", "aisle": "Pantry" },
        { "qty": 2, "unit": "", "item": "large eggs", "aisle": "Dairy & Eggs" },
        { "qty": 1, "unit": "cup", "item": "panko", "aisle": "Pantry" },
        { "qty": 0.5, "unit": "cup", "item": "Italian breadcrumbs", "aisle": "Pantry" },
        { "qty": 0.333, "unit": "cup", "item": "grated Parmesan", "aisle": "Dairy & Eggs" },
        { "qty": 0.5, "unit": "tsp", "item": "garlic powder", "aisle": "Spices" },
        { "qty": 0.5, "unit": "cup", "item": "neutral oil", "note": "for frying", "aisle": "Pantry" },
        { "qty": 1, "unit": "", "item": "lemon", "note": "cut in wedges", "aisle": "Produce" }
      ],
      "steps": [
        { "text": "Slice each chicken breast in half horizontally, then pound to an even ½ inch. Season both sides with the salt and pepper.", "uses": [0, 1, 2] },
        { "text": "Set up three shallow dishes: flour in the first, beaten eggs in the second, and the panko, breadcrumbs, Parmesan and garlic powder mixed in the third.", "uses": [3, 4, 5, 6, 7, 8] },
        { "text": "Dredge each cutlet in flour, dip in egg, then press firmly into the crumbs. Rest on a rack for 5 minutes so the coating sets.", "uses": [] },
        { "text": "Heat the oil in a large skillet over medium-high until a crumb sizzles on contact.", "uses": [9] },
        { "text": "Fry the cutlets in batches, 3 minutes per side, until deep golden and 165°F inside. Drain on the rack.", "uses": [] },
        { "text": "Serve hot with lemon wedges.", "uses": [10] }
      ]
    },
